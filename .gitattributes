# DEFAULT (2026-09-08, L60). Everything git detects as text is LF in the repository.
# This line must stay FIRST: .gitattributes is last-match-wins, so the explicit `binary`
# declarations below still override it for Office files, images and archives.
#
# This replaced an extension ENUMERATION. The enumeration was green and inert: it listed
# .sh/.py/.yml/.json/.toml/.md and therefore silently allowed CRLF into policies/*.cedar
# (the input to the POLICY_VERSION provenance digest), tools/hooks/pre-commit (a bash
# script), lib/CORE_VERSION (hashed by lib/core.lock) and RELEASE. A verifier cloning on
# Windows with stock Git (core.autocrlf=true) would compute different digests than we do
# and fail verification for a reason unrelated to any control.
* text=auto eol=lf

# Prevent git line-ending conversion (core.autocrlf) from corrupting binary files.
# .pptx/.docx/.xlsx are ZIP archives — CRLF<->LF rewriting inside them strips media
# (embedded images) and can make the file unopenable. `binary` = `-text -diff`, so
# git treats these as opaque bytes and never normalizes them. Do NOT remove.

# Office documents
*.pptx  binary
*.ppt   binary
*.docx  binary
*.doc   binary
*.xlsx  binary
*.xls   binary

# PDFs and raster images
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.bmp   binary
*.tif   binary
*.tiff  binary

# Archives, fonts, other binaries
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.emf   binary

# SVG is text (XML) — keep diffable, but pin LF so it round-trips cleanly.
*.svg   text eol=lf

# COPILOT-4 (2026-09-03): shell scripts, Python, YAML, JSON and TOML are LF in the repository — a script
# committed with CRLF fails on Linux (`set -euo pipefail\r`: "invalid option name"), which is exactly
# how the deploy-evidence workflow's layer-staging step broke. CI runs `bash -n` over every *.sh.
*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.cedar  text eol=lf
