"Resource":{"Fn::Join":["",["arn:",{"Ref":"AWS::Partition"},":bedrock:",{"Ref":"AWS::Region"},"::foundation-model/anthropic.claude-3-haiku-20240307-v1:0"]]},"Sid":"BedrockInvokeScoped"},{"Action":["kms:Decrypt","kms:GenerateDataKey"],"Effect":"Allow","Resource":{"Fn::GetAtt":["DataClassKey29DD8918","Arn"]},"Sid":"KmsDataKeyOnCmk"},{"Action":["logs:CreateLogStream","logs:PutLogEvents"],"Effect":"Allow","Resource":[{"Fn::GetAtt":["GatewayLogGroup423AA6D5","Arn"]},{"Fn::Join":["",[{"Fn::GetAtt":["GatewayLogGroup423AA6D5","Arn"]},":*"]]}],"Sid":"LogsToOwnGroup"},{"Action":"ssm:GetParameter","Effect":"Allow","Resource":{"Fn::Join":["",["arn:",{"Ref":"AWS::Partition"},":ssm:",{"Ref":"AWS::Region"},":",{"Ref":"AWS::AccountId"},":parameter",{"Ref":"KillSwitchParamC167709D"}]]},"Sid":"ReadKillSwitch"}],"Version":"2012-10-17"},"policyName":"GatewayRoleDefaultPolicyF4BF688C","roles":[{"Ref":"GatewayRole0A0569CA"}]}}}}}}},"GatewayFunction":{"id":"GatewayFunction","path":"aegis-governance-core/GatewayFunction","constructInfo":{"fqn":"aws-cdk-lib.aws_lambda.Function","version":"2.262.1"},"children":{"Resource":{"id":"Resource","path":"aegis-governance-core/GatewayFunction/Resource","constructInfo":{"fqn":"aws-cdk-lib.aws_lambda.CfnFunction","version":"2.262.1"},"attributes":{"aws:cdk:cloudformation:type":"AWS::Lambda::Function","aws:cdk:cloudformation:logicalId":"GatewayFunctionA7138035","aws:cdk:cloudformation:props":{"code":{"zipFile":"\"\"\"Aegis control-plane gateway (stub).\n\nFail-closed governance boundary: applies the Bedrock guardrail on the input,\nallows the request ONLY when the guardrail explicitly returns NONE (no\nintervention), and writes an append-only audit record with a conditional put.\nByte-for-byte behavioural parity with the ZipFile handler in\ninfra/cloudformation/governance-core.yaml.\n\"\"\"\n\nimport json\nimport os\nimport time\nimport uuid\n\nimport boto3\n\nddb = boto3.client(\"dynamodb\")\nbedrock = boto3.client(\"bedrock-runtime\")\n\nAUDIT_TABLE = os.environ[\"AUDIT_TABLE\"]\nGUARDRAIL_ID = os.environ.get(\"GUARDRAIL_ID\", \"\")\nGUARDRAIL_VERSION = os.environ.get(\"GUARDRAIL_VERSION\", \"DRAFT\")\nDATA_CLASS = os.environ.get(\"DATA_CLASS\", \"unknown\")\n\n\ndef _apply_guardrail(text):\n    \"\"\"Apply the Bedrock guardrail on input text. Best-effort: never block\n    the audit write if guardrail access is not yet enabled.\"\"\"\n    if not GUARDRAIL_ID:\n        # Fail closed: no guardrail configured means we cannot vouch for the request.\n        return {\"action\": \"UNAVAILABLE\", \"reason\": \"no-guardrail-configured\"}\n    try:\n        resp = bedrock.apply_guardrail(\n            guardrailIdentifier=GUARDRAIL_ID,\n            guardrailVersion=str(GUARDRAIL_VERSION),\n            source=\"INPUT\",\n            content=[{\"text\": {\"text\": text}}],\n        )\n        return {\"action\": resp.get(\"action\", \"NONE\")}\n    except Exception as exc:  # noqa: BLE001\n        return {\"action\": \"ERROR\", \"reason\": str(exc)}\n\n\ndef handler(event, context):\n    request_id = (event or {}).get(\"request_id\") or str(uuid.uuid4())\n    prompt = (event or {}).get(\"prompt\", \"hello from aegis gateway\")\n\n    guardrail_result = _apply_guardrail(prompt)\n    action = str(guardrail_result.get(\"action\"))\n\n    # FAIL CLOSED: allow only when the guardrail explicitly returned NONE\n    # (no intervention). Any intervention, error, or inability to evaluate\n    # denies the request. Mandatory governance boundary.\n    allowed = action == \"NONE\"\n    decision = \"allow\" if allowed else \"deny\"\n\n    item = {\n        \"request_id\": {\"S\": request_id},\n        \"seq\": {\"N\": \"0\"},\n        \"ts\": {\"N\": str(int(time.time()))},\n        \"data_class\": {\"S\": DATA_CLASS},\n        \"decision\": {\"S\": decision},\n        \"guardrail_action\": {\"S\": action},\n        \"purpose\": {\"S\": (event or {}).get(\"purpose\", \"demo\")},\n    }\n    ddb.put_item(\n        TableName=AUDIT_TABLE,\n        Item=item,\n        ConditionExpression=\"attribute_not_exists(request_id) AND attribute_not_exists(seq)\",\n    )\n\n    return {\n        \"statusCode\": 200 if allowed else 403,\n        \"decision\": decision,\n        \"request_id\": request_id,\n        \"seq\": 0,\n        \"guardrail\": guardrail_result,\n        \"body\": json.dumps({\"status\": \"audited\", \"decision\": decision, \"request_id\": request_id}),\n    }\n"},"description":"Aegis control-plane gateway entrypoint (stub) - writes an audit record and applies the guardrail.","environment":{"variables":{"AUDIT_TABLE":{"Ref":"AuditTableB07F8EEB"},"APPROVAL_LEDGER":{"Ref":"ApprovalsTableF18C2B8F"},"GUARDRAIL_ID":{"Fn::GetAtt":["AegisGuardrail","GuardrailId"]},"GUARDRAIL_VERSION":{"Fn::GetAtt":["AegisGuardrail","Version"]},"DATA_CLASS":"pii","KILL_SWITCH_PARAM":{"Ref":"KillSwitchParamC167709D"}}},"functionName":"aegis-gateway-pii-dev","handler":"index.handler","loggingConfig":{"logGroup":{"Ref":"GatewayLogGroup423AA6D5"}},"memorySize":128,"role":{"Fn::GetAtt":["GatewayRole0A0569CA","Arn"]},"runtime":"python3.12","tags":[{"key":"app","value":"aegis"},{"key":"data_class","value":"pii"},{"key":"dept","value":"shared-services"},{"key":"environment","value":"dev"},{"key":"pack","value":"enterprise"}],"timeout":30}}}}},"AuditTableName":{"id":"AuditTableName","path":"aegis-governance-core/AuditTableName","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"2.262.1"}},"ApprovalsTableName":{"id":"ApprovalsTableName","path":"aegis-governance-core/ApprovalsTableName","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"2.262.1"}},"WormBucketName":{"id":"WormBucketName","path":"aegis-governance-core/WormBucketName","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"2.262.1"}},"GuardrailId":{"id":"GuardrailId","path":"aegis-governance-core/GuardrailId","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"2.262.1"}},"UserPoolId":{"id":"UserPoolId","path":"aegis-governance-core/UserPoolI