        <mxCell id="n69" value="deny all" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#3C4043;strokeColor=#5F6368;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;strokeColor=#DD344C;" parent="1" edge="1" source="n50" target="n20">
