        <mxCell id="n45" value="Model-invocation log
regulated store" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#01A88D;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" parent="1" vertex="1">
          <mxGeometry x="510" y="805" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n46" value="SNS + alarms
bypass detector" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#E7157B;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" parent="1" vertex="1">
          <mxGeometry x="650" y="805" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n47" value="&lt;b&gt;One correlation set — trace, session, execution, tenant — is carried through every hop and hashed into the ledger row&lt;/b&gt;, so the audit record proves its own join keys. &lt;b&gt;lineage_proof&lt;/b&gt; reconciles CloudTrail invocations against aegis.call audit lines in both directions and reports orphans. A detective alarm fires on any Bedrock caller outside the allow-listed role — that is how a bypass is &lt;i&gt;seen&lt;/i&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#3C4043;" parent="1" vertex="1">
          <mxGeometry x="790" y="805" width="390" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n48" value="&lt;b&gt;Qualification:&lt;/b&gt; the gate's &lt;i&gt;orphans=0&lt;/i&gt; was computed over 11 of 13 governed tools (register L41, fixed after the tag)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;" parent="1" vertex="1">
          <mxGeometry x="790" y="900" width="390" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="n49" value="7 · CONTAINMENT &amp;amp; COST CEILING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DD344C;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#DD344C;align=left;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="1220" y="190" width="360" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="n50" value="SSM Parameter
KILL SWITCH" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#E7157B;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager_parameter_store;" parent="1" vertex="1">
