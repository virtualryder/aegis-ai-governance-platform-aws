        <mxCell id="n37" value="S3 WORM Vault
Object Lock + hash chain" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#7AA116;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" parent="1" vertex="1">
          <mxGeometry x="990" y="545" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n38" value="AWS KMS
customer-managed" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#DD344C;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kms;" parent="1" vertex="1">
          <mxGeometry x="1120" y="545" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n39" value="&lt;b&gt;Append-only ledger + hash chain&lt;/b&gt;, IAM Deny on update/delete and on Object-Lock bypass. Evidence is written &lt;b&gt;before&lt;/b&gt; any side effect (durable-evidence gating), so an audit failure can never follow a completed action." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#3C4043;" parent="1" vertex="1">
          <mxGeometry x="850" y="632" width="330" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="n40" value="&lt;b&gt;AUDITOR CAVEAT:&lt;/b&gt; every gate ran Object Lock in &lt;b&gt;GOVERNANCE&lt;/b&gt; mode, 1-day retention, so the environment could be torn down. &lt;b&gt;COMPLIANCE&lt;/b&gt; mode (7-year) is IaC only and has never been deployed live (EV-1)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B31412;" parent="1" vertex="1">
          <mxGeometry x="850" y="690" width="330" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="n41" value="6 · OBSERVABILITY, LINEAGE &amp;amp; AUDIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#8C4FFF;align=left;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="60" y="770" width="1140" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="n42" value="CloudTrail
capture-all trail (WORM)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#E7157B;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" parent="1" vertex="1">
          <mxGeometry x="90" y="805" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n43" value="CloudWatch Logs
CMK-encrypted" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#E7157B;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" parent="1" vertex="1">
