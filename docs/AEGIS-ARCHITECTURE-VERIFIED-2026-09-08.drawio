        <mxCell id="n12" value="1 · IDENTITY &amp;amp; ENTRY  — who is asking, and are they who they say" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#DD344C;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#DD344C;align=left;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
