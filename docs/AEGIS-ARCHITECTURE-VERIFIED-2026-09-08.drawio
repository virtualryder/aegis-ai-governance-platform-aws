        <mxCell id="n13" value="AWS WAFv2
REGIONAL Web ACL" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#DD344C;strokeColor=#F59E0B;strokeWidth=3;dashed=1;dashPattern=8 4;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.WAF;" parent="1" vertex="1">
