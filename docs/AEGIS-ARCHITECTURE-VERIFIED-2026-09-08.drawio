        </mxCell>
        <mxCell id="n51" value="AWS Budgets
USD ceiling" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#E7157B;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.budgets;" parent="1" vertex="1">
          <mxGeometry x="1400" y="230" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n52" value="Organizations SCP
preventive perimeter" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#E7157B;strokeColor=#9AA0A6;strokeWidth=3;dashed=1;dashPattern=1 4;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;" parent="1" vertex="1">
          <mxGeometry x="1250" y="400" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n53" value="Account enforced
guardrail" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#DD344C;strokeColor=#9AA0A6;strokeWidth=3;dashed=1;dashPattern=1 4;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.shield;" parent="1" vertex="1">
          <mxGeometry x="1400" y="400" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n54" value="&lt;b&gt;Kill switch:&lt;/b&gt; one SSM parameter, checked by the interceptor, the tool Lambdas and the runtime with a 15s TTL. Engaging it stops the governed path everywhere; every engage/disengage is IAM-attributed and WORM-audited. &lt;b&gt;Live-proven.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#3C4043;" parent="1" vertex="1">
          <mxGeometry x="1250" y="320" width="320" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="n55" value="&lt;b&gt;Budget:&lt;/b&gt; per-tenant token + USD meter, reserve-before / commit-after on every model call, refusing &lt;i&gt;before&lt;/i&gt; the spend at runtime, gateway and drafter. The AWS Budgets ceiling is a &lt;b&gt;slow backstop&lt;/b&gt; — AWS billing data refreshes at least daily and alerts once per period — not a real-time cap." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#3C4043;" parent="1" vertex="1">
          <mxGeometry x="1250" y="490" width="320" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n56" value="&lt;b&gt;OPEN — needs an AWS Organization.&lt;/b&gt; An SCP is the only way to &lt;i&gt;prevent&lt;/i&gt; a non-governed principal from calling Bedrock. Today that bypass is DETECTED, not prevented.&lt;br&gt;&lt;b&gt;Available but not applied:&lt;/b&gt; an account-level enforced guardrail needs no Organization and would make any bypass call guardrailed. Operator decision — it affects every Bedrock call in the account." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B31412;" parent="1" vertex="1">
          <mxGeometry x="1250" y="575" width="320" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="n57" value="RS256 JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;fontColor=#3C4043;strokeColor=#5F6368;strokeWidth=2;endArrow=blockThin;endFill=1;" parent="1" edge="1" source="n14" target="n18">
