        <mxCell id="n14" value="Amazon Cognito
MFA-required (pilot)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#DD344C;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" parent="1" vertex="1">
          <mxGeometry x="90" y="345" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;What:&lt;/b&gt; managed rate-limit + AWS common rule set on the auth front door.&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; the token endpoint is the only public surface; it needs a shield.&lt;br&gt;&lt;b&gt;Status:&lt;/b&gt; built as IaC; the WAF↔Cognito association is a documented AWS propagation delay and is not yet proven live (#189)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#3C4043;" parent="1" vertex="1">
          <mxGeometry x="180" y="228" width="172" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;What:&lt;/b&gt; issues the RS256 JWT every request carries. Federation-ready (Entra/Okta/Ping via OIDC).&lt;br&gt;&lt;b&gt;Why:&lt;/b&gt; identity must be &lt;i&gt;cryptographic&lt;/i&gt;, not asserted — Cedar authorizes on a verified subject and group.&lt;br&gt;&lt;b&gt;Proven:&lt;/b&gt; real MFA login → JWT verified vs JWKS → group → Cedar decision." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#3C4043;" parent="1" vertex="1">
          <mxGeometry x="180" y="348" width="172" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="2 · GOVERNED CONTROL PLANE  — the deny-by-default choke point" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E7157B;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#E7157B;align=left;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="380" y="190" width="420" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="AgentCore Gateway
MCP · CUSTOM_JWT" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#E7157B;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.gateway;" parent="1" vertex="1">
          <mxGeometry x="410" y="230" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="AgentCore Policy
Cedar · ENFORCE" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#DD344C;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management_permissions;" parent="1" vertex="1">
          <mxGeometry x="560" y="230" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="Tenant Interceptor
(authoritative context)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#ED7100;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" parent="1" vertex="1">
          <mxGeometry x="710" y="230" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;Every governed tool call passes here.&lt;/b&gt; The gateway advertises only the tools the caller's verified entitlement claim allows — a missing or malformed claim grants ZERO tools, not all of them. Cedar then evaluates 9 conditions (entitlement, consent, purpose, budget, temporal window, quantitative cap, separation of duties, masking-before-use, no self-commit) and DENIES by default. The interceptor &lt;i&gt;overwrites&lt;/i&gt; caller-supplied context from authoritative stores, so a client cannot assert its own consent or budget." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#3C4043;" parent="1" vertex="1">
          <mxGeometry x="410" y="320" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;Why this shape:&lt;/b&gt; governance that lives inside the agent can be prompted away. Putting it in the gateway makes it structural — the model never holds the decision." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B31412;" parent="1" vertex="1">
          <mxGeometry x="410" y="424" width="380" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="3 · AGENT RUNTIME &amp;amp; MODEL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#01A88D;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#01A88D;align=left;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="820" y="190" width="380" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="AgentCore Runtime
Strands agent, IaC role" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#ED7100;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" parent="1" vertex="1">
          <mxGeometry x="850" y="230" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="Bedrock Guardrail
pinned version" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#DD344C;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.shield;" parent="1" vertex="1">
          <mxGeometry x="990" y="230" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="Amazon Bedrock
Claude Sonnet 4.5" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#01A88D;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" parent="1" vertex="1">
          <mxGeometry x="1120" y="230" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;Runtime:&lt;/b&gt; runs on the CDK-exported least-privilege execution role (never the toolkit's auto-generated one), IMDSv2 required, bounded plain-string input contract validated before any I/O.&lt;br&gt;&lt;b&gt;Guardrail:&lt;/b&gt; pinned version + contextual grounding; IAM &lt;i&gt;requires&lt;/i&gt; the exact guardrail ARN — a call without it is denied, not merely unguarded.&lt;br&gt;&lt;b&gt;Model:&lt;/b&gt; reached over VPC endpoints; every invocation is logged and metered." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#3C4043;" parent="1" vertex="1">
          <mxGeometry x="850" y="320" width="330" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;RT-4 (new, not live-proven):&lt;/b&gt; the runtime's authorizer now sets &lt;i&gt;allowedWorkloadConfiguration&lt;/i&gt; so only this deployment's Gateway may invoke it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B45309;" parent="1" vertex="1">
          <mxGeometry x="850" y="428" width="330" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="n29" value="4 · GOVERNED TOOLS &amp;amp; HUMAN DECISION GATE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ED7100;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#ED7100;align=left;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
          <mxGeometry x="60" y="510" width="740" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="n30" value="Tool Lambdas
mask · assess · draft · finalize" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#ED7100;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" parent="1" vertex="1">
          <mxGeometry x="90" y="545" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="Step Functions
workflow + waitForTaskToken" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#E7157B;strokeColor=#1A73E8;strokeWidth=3;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" parent="1" vertex="1">
          <mxGeometry x="250" y="545" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="System-of-record
connector" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fontSize=10;gradientColor=none;fillColor=#8C4FFF;strokeColor=#9AA0A6;strokeWidth=3;dashed=1;dashPattern=1 4;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;whiteSpace=wrap;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" parent="1" vertex="1">
          <mxGeometry x="410" y="545" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;One Lambda per manifest tool&lt;/b&gt;, explicit least-privilege IAM each. mask_pii mints a &lt;b&gt;signed sanitized_ref&lt;/b&gt;; downstream tools authorize on that signature — a caller-supplied &lt;i&gt;deidentified: true&lt;/i&gt; is never accepted. Case text moves &lt;b&gt;by reference&lt;/b&gt;, so raw PII never crosses workflow state.&lt;br&gt;&lt;b&gt;Human gate:&lt;/b&gt; the workflow suspends on waitForTaskToken; sign-off re-verifies approver identity and enforces approver ≠ requester. No adverse action is autonomous." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=8;fontColor=#3C4043;" parent="1" vertex="1">
          <mxGeometry x="90" y="632" width="480" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;NOT DEPLOYED.&lt;/b&gt; The only real external connector (verify_income) is deliberately not deployed and not a Gateway target. &lt;b&gt;Every live run to date has governed tools over SYNTHETIC data.&lt;/b&gt; Governing a real system of record is the #1 pilot gap." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;fontColor=#B31412;" parent="1" vertex="1">
          <mxGeometry x="580" y="545" width="205" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="5 · DATA &amp;amp; EVIDENCE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7AA116;strokeWidth=2;dashed=0;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#7AA116;align=left;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
