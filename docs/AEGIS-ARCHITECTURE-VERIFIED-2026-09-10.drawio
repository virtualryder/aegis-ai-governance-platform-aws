ry x="536" y="2896" width="800" height="46" as="geometry"/></mxCell><mxCell id="n227" value="Detects a direct Bedrock call that went around the governed path. &lt;b&gt;Detective only&lt;/b&gt; &amp;#8212; prevention needs an Organization." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2896" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n228" value="&lt;b&gt;Kill switch&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2942" width="250" height="46" as="geometry"/></mxCell><mxCell id="n229" value="8 Operations" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2942" width="130" height="46" as="geometry"/></mxCell><mxCell id="n230" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2942" width="74" height="46" as="geometry"/></mxCell><mxCell id="n231" value="One SSM parameter; engage/disengage is IAM-attributed and WORM-audited; 13.9s to effect." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2942" width="800" height="46" as="geometry"/></mxCell><mxCell id="n232" value="One lever halts the governed path everywhere, with a record of who pulled it and why." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2942" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n233" value="&lt;b&gt;Per-tenant budget&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2988" width="250" height="46" as="geometry"/></mxCell><mxCell id="n234" value="8 Operations" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2988" width="130" height="46" as="geometry"/></mxCell><mxCell id="n235" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2988" width="74" height="46" as="geometry"/></mxCell><mxCell id="n236" value="Reserve-before / commit-after metering; 60% and 85% alarms; AWS Budgets ceiling engages the kill switch." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2988" width="800" height="46" as="geometry"/></mxCell><mxCell id="n237" value="Stops runaway spend before it happens rather than reporting it after, and bounds a compromised agent's blast radius." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2988" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n238" value="&lt;b&gt;Alarms &amp;amp; severity tiers&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="3034" width="250" height="46" as="geometry"/></mxCell><mxCell id="n239" value="8 Operations" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="3034" width="130" height="46" as="geometry"/></mxCell><mxCell id="n240" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="3034" width="74" height="46" as="geometry"/></mxCell><mxCell id="n241" value="26 named alarms across workflow health, per-function errors, guard failures, per-tenant budget, latency and perimeter bypass, in 3 composite severity tiers (P1 page / P2 ticket / P3 advisory), each with its own SNS topic." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="3034" width="800" height="46" as="geometry"/></mxCell><mxCell id="n242" value="Turns 26 signals into a triage order rather than one undifferentiated topic. Every alarm has a first action in docs/ops/INCIDENT-RUNBOOK.md, enforced by a test. &lt;b&gt;Never yet observed firing in a real incident&lt;/b&gt; &amp;#8212; that is OBS-B1." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="3034" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n243" value="&lt;b&gt;Operations dashboard&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="3080" width="250" height="46" as="geometry"/></mxCell><mxCell id="n244" value="8 Operations" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="3080" width="130" height="46" as="geometry"/></mxCell><mxCell id="n245" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="3080" width="74" height="46" as="geometry"/></mxCell><mxCell id="n246" value="One dashboard, six widgets." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="3080" width="800" height="46" as="geometry"/></mxCell><mxCell id="n247" value="The remaining weak spot on this page: there is no per-tenant operational view, no synthetic canary and no DR exercise. Adequate for a supervised pilot; not an operations posture." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="3080" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n248" value="&lt;b&gt;Organization SCP&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="3126" width="250" height="46" as="geometry"/></mxCell><mxCell id="n249" value="&amp;#8212;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="3126" width="130" height="46" as="geometry"/></mxCell><mxCell id="n250" value="&lt;b&gt;OFF&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#6B7785;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="3126" width="74" height="46" as="geometry"/></mxCell><mxCell id="n251" value="org/scp-bedrock-runtime-perimeter.json &amp;#8212; a lint-validated template." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="3126" width="800" height="46" as="geometry"/></mxCell><mxCell id="n252" value="&lt;b&gt;Would&lt;/b&gt; make account-wide governance preventive. Blocked on an AWS Organization (PERIM-1b). Today: detection only." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="3126" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n253" value="&lt;b&gt;System-of-record connector&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="3172" width="250" height="46" as="geometry"/></mxCell><mxCell id="n254" value="&amp;#8212;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="3172" width="130" height="46" as="geometry"/></mxCell><mxCell id="n255" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1A7F37;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="3172" width="74" height="46" as="geometry"/></mxCell><mxCell id="n256" value="lib/connector/ &amp;#8212; &lt;b&gt;verify_source&lt;/b&gt;, a Gateway target since 2026-09-10. Outbound OAuth2 token from the AgentCore Identity vault; the tool holds no secret." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="3172" width="800" height="46" as="geometry"/></mxCell><mxCell id="n257" value="The system of record is a &lt;b&gt;real&lt;/b&gt; OAuth2 API with RS256/JWKS signature verification &amp;#8212; &lt;b&gt;and it is ours&lt;/b&gt;. It refuses an unauthenticated caller (401) and an outsider is denied by Cedar. &lt;b&gt;No customer system of record has been governed&lt;/b&gt;; connect_system_of_record stays stubbed. Still the pre-pilot item." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="3172" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n258" value="&lt;b&gt;What this diagram does not claim.&lt;/b&gt; &amp;nbsp; No real or regulated data has ever passed through any component on this page, and the OAuth2 system of record the connector reaches is &lt;b&gt;ours, not a customer&apos;s&lt;/b&gt;. Evidence is author-produced on one AWS account and no third party has reproduced it &amp;#8212; the protocol for doing so is &lt;b&gt;docs/INDEPENDENT-VERIFICATION.md&lt;/b&gt;. Three of the four vertical packs (pharmacovigilance, financial-aid, housing) share this hash-locked core and have &lt;b&gt;never been deployed&lt;/b&gt;; housing wires 3 of 17 controls. Account-wide &lt;i&gt;prevention&lt;/i&gt; requires an AWS Organization that does not exist. There is no penetration test, DR exercise, SLO or ATO. &amp;quot;Zero residue&amp;quot; excludes the toolkit ECR repository, which grows one image per run (L37). If any wording elsewhere reads as stronger than this, &lt;b&gt;NOT-CLAIMS.md governs&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEF;strokeColor=#DD344C;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="3268" width="2600" height="96" as="geometry"/></mxCell><mxCell id="n259" value="OIDC access token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n18" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n260" value="authorize" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n30" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n261" value="context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n32" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n262" value="permitted tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n33" target="n38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n263" value="Converse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n38" target="n41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n264" value="assessed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n41" target="n44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n265" value="drives the case" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n38" target="n49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n266" value="audit before side effect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n49" target="n85"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n267" value="delivery" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n100" target="n103"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n268" value="WORM copy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n103" target="n106"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n269" value="breach &amp;#8594; engage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n122" target="n124"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n270" value="notify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n116" target="n118"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>