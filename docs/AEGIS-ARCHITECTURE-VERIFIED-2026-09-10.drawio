<mxfile host="app.diagrams.net" modified="2026-09-09T00:00:00.000Z" agent="aegis" version="24.0.0"><diagram id="aegis-verified" name="Aegis Verified Architecture"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2760" pageHeight="3428" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="Aegis &amp;#8212; Governed-Agent Control Plane for Amazon Bedrock AgentCore" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;strokeWidth=1;dashed=0;fontSize=20;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1700" height="40" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;As-deployed architecture, verified 2026-09-10.&lt;/b&gt; Drawn from the tree at tag &lt;b&gt;v0.7.0-pilot-rc1&lt;/b&gt; (benefits_eligibility_agent), which passed a &lt;b&gt;21/21 full-portfolio gate from zero&lt;/b&gt; on account/region us-east-1, two tenants, a real AgentCore Runtime, synthetic data &amp;#8212; then tore down to zero residue. Evidence: &lt;b&gt;evidence/FULL-PORTFOLIO-GATE-benefits_runtime_agent.json&lt;/b&gt; (run &lt;b&gt;ben-fpg&lt;/b&gt;; the 2026-09-09 run in the previous edition of this diagram passed 17/17, and the four new checks are the governed system-of-record connector and its residue sweep). Border style is a claim: &lt;b&gt;solid = exercised live in that gate&lt;/b&gt;, &lt;b&gt;dashed = built by CDK and unit-asserted only&lt;/b&gt;, &lt;b&gt;dotted grey = shipped but deliberately not deployed&lt;/b&gt;. Nothing on this page is proven on real data." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C9D2DA;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1760" y="24" width="880" height="88" as="geometry"/></mxCell><mxCell id="n13" value="Verification key" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF2F5;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=12;fontStyle=1;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="240" height="26" as="geometry"/></mxCell><mxCell id="n14" value="LIVE &amp;#8212; exercised in the 21/21 gate" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D8102;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="240" height="24" as="geometry"/></mxCell><mxCell id="n15" value="IAC &amp;#8212; CDK-built, unit-asserted only" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B26A00;strokeWidth=1;dashed=1;dashPattern=8 6;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="108" width="250" height="24" as="geometry"/></mxCell><mxCell id="n16" value="OFF &amp;#8212; shipped, not deployed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#6B7785;strokeWidth=1;dashed=1;dashPattern=8 6;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="108" width="230" height="24" as="geometry"/></mxCell><mxCell id="n17" value="1 &amp;#183; IDENTITY &amp;amp; ADMISSION &amp;nbsp;&amp;nbsp;&lt;font style='font-size:12px;font-weight:normal;color:#5A6B7B'&gt;who is calling, and what claims does the platform trust about them&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="2600" height="190" as="geometry"/></mxCell><mxCell id="n18" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="130" y="206" width="78" height="78" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;user pool &amp;#183; federation-ready&lt;br&gt;zero built-in users" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="84" y="286" width="170" height="56" as="geometry"/></mxCell><mxCell id="n20" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="188" y="197" width="42" height="15" as="geometry"/></mxCell><mxCell id="n21" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="1"><mxGeometry x="330" y="206" width="78" height="78" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;AWS WAF&lt;/b&gt;&lt;br&gt;managed rules + rate limit&lt;br&gt;on the auth front door" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="284" y="286" width="170" height="56" as="geometry"/></mxCell><mxCell id="n23" value="IAC" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#B26A00;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="388" y="197" width="42" height="15" as="geometry"/></mxCell><mxCell id="n24" value="Enterprise IdP&lt;br&gt;(Okta / Entra ID / Ping)&lt;br&gt;&lt;i&gt;customer-side, OIDC&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#6B7785;strokeWidth=1;dashed=1;dashPattern=8 6;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="212" width="190" height="76" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Claims the platform trusts&lt;/b&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;cognito:groups&lt;/b&gt; &amp;#8594; role + tools_granted + tenant_*&lt;br&gt;&amp;#8226; &lt;b&gt;custom:tenant&lt;/b&gt; &amp;#8594; tenancy, from the token only&lt;br&gt;&amp;#8226; &lt;b&gt;custom:tools&lt;/b&gt; &amp;#8594; per-user entitlement (zero default)&lt;br&gt;&lt;i&gt;case_id / requester are correlation keys, never authority (R4-9)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C9D2DA;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="720" y="206" width="470" height="104" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Why this layer exists.&lt;/b&gt; Tenancy and entitlement are derived from the &lt;i&gt;verified token&lt;/i&gt;, never from the request body. A caller cannot name the tenant they want to read. This is what makes cross-tenant access impossible by construction rather than by check.&lt;br&gt;&lt;br&gt;&lt;b&gt;Open:&lt;/b&gt; the enterprise IdP round-trip has never been exercised (R4-15). MFA is on and asserted in IaC; the federation path is configuration, not evidence." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#B26A00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1230" y="206" width="620" height="104" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Not present: an AWS Organization.&lt;/b&gt; Without one there is no SCP, so a principal calling Bedrock directly is &lt;b&gt;detected, not prevented&lt;/b&gt; (R4-1 / PERIM-1b). Everything below governs the &lt;i&gt;governed path&lt;/i&gt;. The account-wide net is capture, in band 7." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEF;strokeColor=#DD344C;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1890" y="206" width="700" height="104" as="geometry"/></mxCell><mxCell id="n28" value="2 &amp;#183; AUTHORIZATION &amp;#8212; THE ENFORCEMENT POINT &amp;nbsp;&amp;nbsp;&lt;font style='font-size:12px;font-weight:normal;color:#5A6B7B'&gt;deny-by-default, evaluated by AWS before any tool runs&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="374" width="2600" height="230" as="geometry"/></mxCell><mxCell id="n29" value="" style="rounded=1;arcSize=18;html=1;fillColor=#E7157B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="94" y="430" width="170" height="12" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;AgentCore Gateway&lt;/b&gt;&lt;br&gt;MCP &amp;#183; CUSTOM_JWT&lt;br&gt;advertises the tool list" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;dashed=0;fontSize=11;fontColor=#232F3E;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="94" y="438" width="170" height="114" as="geometry"/></mxCell><mxCell id="n31" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="218" y="421" width="42" height="15" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;AgentCore Cedar Policy Engine&lt;/b&gt;&lt;br&gt;GA, mode = &lt;b&gt;ENFORCE&lt;/b&gt;&lt;br&gt;deny-by-default &amp;#183; &lt;b&gt;forbid wins&lt;/b&gt;&lt;br&gt;13 policies &amp;#183; 1 permit, 12 forbid" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE7F1;strokeColor=#E7157B;strokeWidth=1;dashed=0;fontSize=12;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="426" width="300" height="108" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;REQUEST interceptor&lt;/b&gt;&lt;br&gt;sets the authoritative context:&lt;br&gt;tenant &amp;#183; budget_ok &amp;#183; within_service_window&lt;br&gt;&lt;i&gt;caller values are overwritten&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDE7F1;strokeColor=#E7157B;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="630" y="426" width="290" height="108" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;The 13 policies, by what they defend&lt;/b&gt; &amp;#8212; full text in the brief, &amp;#167;5&lt;br&gt;&lt;b&gt;Admission (3):&lt;/b&gt; require_tenant &amp;#183; require_entitlement &amp;#183; require_service_window&lt;br&gt;&lt;b&gt;De-identification (4):&lt;/b&gt; mask_before_assess / _draft / _redetermine / _overpayment&lt;br&gt;&lt;b&gt;Separation of duties (2):&lt;/b&gt; no_self_commit &amp;#183; no_self_fraud_referral&lt;br&gt;&lt;b&gt;Purpose &amp;amp; spend (3):&lt;/b&gt; consent_purpose_before_assess &amp;#183; budget_before_draft &amp;#183; amount_cap_overpayment&lt;br&gt;&lt;b&gt;Grant (1):&lt;/b&gt; caseworker_permit &amp;#8212; the only permit in the set" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C9D2DA;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="950" y="420" width="800" height="130" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;Why the asymmetry matters.&lt;/b&gt; Cedar is forbid-wins, so the twelve forbids are the product and the single permit is only the door being unlocked. A missing or malformed claim yields &lt;b&gt;zero&lt;/b&gt; tools, not all of them &amp;#8212; the failure mode most agent stacks get backwards.&lt;br&gt;&lt;br&gt;&lt;b&gt;Optional context fields are presence-guarded&lt;/b&gt;, so an absent value fails &lt;i&gt;closed&lt;/i&gt;: the forbid fires. Proven live: 13 policies ACTIVE, twice, in the 21/21 gate &amp;#8212; and in that gate deny-by-default reached a &lt;i&gt;newly added&lt;/i&gt; tool with no new policy written." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F7EC;strokeColor=#1D8102;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1790" y="420" width="800" height="130" as="geometry"/></mxCell><mxCell id="n36" value="3 &amp;#183; AGENT RUNTIME &amp;amp; MODEL &amp;nbsp;&amp;nbsp;&lt;font style='font-size:12px;font-weight:normal;color:#5A6B7B'&gt;the model is a participant in the workflow, never its controller&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="628" width="2600" height="200" as="geometry"/></mxCell><mxCell id="n37" value="" style="rounded=1;arcSize=18;html=1;fillColor=#01A88D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="94" y="678" width="170" height="12" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;AgentCore Runtime&lt;/b&gt;&lt;br&gt;IaC execution role&lt;br&gt;MMDSv2 required" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=2;dashed=0;fontSize=11;fontColor=#232F3E;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="94" y="686" width="170" height="114" as="geometry"/></mxCell><mxCell id="n39" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="218" y="669" width="42" height="15" as="geometry"/></mxCell><mxCell id="n40" value="" style="rounded=1;arcSize=18;html=1;fillColor=#01A88D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="294" y="678" width="170" height="12" as="geometry"/></mxCell><mxCell id="n41" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;reached over PrivateLink&lt;br&gt;from private subnets" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=2;dashed=0;fontSize=11;fontColor=#232F3E;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="294" y="686" width="170" height="114" as="geometry"/></mxCell><mxCell id="n42" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="418" y="669" width="42" height="15" as="geometry"/></mxCell><mxCell id="n43" value="" style="rounded=1;arcSize=18;html=1;fillColor=#DD344C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="678" width="170" height="12" as="geometry"/></mxCell><mxCell id="n44" value="&lt;b&gt;Bedrock Guardrail&lt;/b&gt;&lt;br&gt;exact ARN required by IAM&lt;br&gt;PII + content policy" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2;dashed=0;fontSize=11;fontColor=#232F3E;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="494" y="686" width="170" height="114" as="geometry"/></mxCell><mxCell id="n45" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="618" y="669" width="42" height="15" as="geometry"/></mxCell><mxCell id="n46" value="&lt;b&gt;Guardrail enforcement is an IAM condition, not a convention.&lt;/b&gt; The drafter and runtime roles &lt;b&gt;allow&lt;/b&gt; on StringEquals of the exact guardrail ARN and carry an explicit &lt;b&gt;Deny&lt;/b&gt; on StringNotEquals, with model and inference-profile ARNs scoped to the manifest model. A call without &lt;i&gt;that&lt;/i&gt; guardrail is denied &amp;#8212; not merely unguarded (R4-3, closed).&lt;br&gt;Gate evidence: &lt;b&gt;runtime_rows=20, guardrail_assessed=20&lt;/b&gt; &amp;#8212; every runtime model call assessed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C9D2DA;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="720" y="674" width="900" height="120" as="geometry"/></mxCell><mxCell id="n47" value="&lt;b&gt;R4-2 is OPEN, and stated as open.&lt;/b&gt; RT-4 restricted the runtime authorizer to the Gateway workload. It works &amp;#8212; and the Gateway is &lt;i&gt;downstream&lt;/i&gt; of the Runtime here, so it left no permitted invoker and failed four gate checks. RT-4 is now opt-in (RT4_GATEWAY_ONLY=1), &lt;b&gt;off by default&lt;/b&gt;. The bypass is mitigated where it bites: at the gateway, by the four mask_before_* forbids, which refuse the consequential actions unless the payload is proven de-identified &amp;#8212; whoever makes the call." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEF;strokeColor=#DD344C;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1660" y="674" width="930" height="120" as="geometry"/></mxCell><mxCell id="n48" value="4 &amp;#183; DETERMINISTIC ORCHESTRATION &amp;nbsp;&amp;nbsp;&lt;font style='font-size:12px;font-weight:normal;color:#5A6B7B'&gt;AWS Step Functions STANDARD &amp;#8212; the controller cannot advance on unverified state&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="852" width="2600" height="210" as="geometry"/></mxCell><mxCell id="n49" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="130" y="902" width="78" height="78" as="geometry"/></mxCell><mxCell id="n50" value="&lt;b&gt;Step Functions&lt;/b&gt;&lt;br&gt;STANDARD state machine" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="84" y="982" width="170" height="56" as="geometry"/></mxCell><mxCell id="n51" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="188" y="893" width="42" height="15" as="geometry"/></mxCell><mxCell id="n52" value="&lt;b&gt;Extract&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="914" width="152" height="44" as="geometry"/></mxCell><mxCell id="n53" value="&lt;b&gt;GuardExtracted&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEF;strokeColor=#DD344C;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="466" y="914" width="152" height="44" as="geometry"/></mxCell><mxCell id="n54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n52" target="n53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n55" value="&lt;b&gt;MaskPii&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="632" y="914" width="152" height="44" as="geometry"/></mxCell><mxCell id="n56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n53" target="n55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n57" value="&lt;b&gt;GuardDeidentified&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEF;strokeColor=#DD344C;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="798" y="914" width="152" height="44" as="geometry"/></mxCell><mxCell id="n58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n55" target="n57"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n59" value="&lt;b&gt;AssessEligibility&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="964" y="914" width="152" height="44" as="geometry"/></mxCell><mxCell id="n60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n57" target="n59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n61" value="&lt;b&gt;GuardRulesExecuted&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEF;strokeColor=#DD344C;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="914" width="152" height="44" as="geometry"/></mxCell><mxCell id="n62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n59" target="n61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n63" value="&lt;b&gt;CheckAdverseNotice&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEF;strokeColor=#DD344C;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1296" y="914" width="152" height="44" as="geometry"/></mxCell><mxCell id="n64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n61" target="n63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n65" value="&lt;b&gt;DraftNotice&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1462" y="914" width="152" height="44" as="geometry"/></mxCell><mxCell id="n66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n63" target="n65"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n67" value="&lt;b&gt;AuditIntent&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0F7E6;strokeColor=#7AA116;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1628" y="914" width="152" height="44" as="geometry"/></mxCell><mxCell id="n68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n65" target="n67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n69" value="&lt;b&gt;HumanSignoff&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4D72F3;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1794" y="914" width="152" height="44" as="geometry"/></mxCell><mxCell id="n70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n67" target="n69"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n71" value="&lt;b&gt;AdverseNoticeHold&lt;/b&gt;&lt;br&gt;&lt;i&gt;terminal&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEF;strokeColor=#DD344C;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1900" y="982" width="160" height="46" as="geometry"/></mxCell><mxCell id="n72" value="&lt;b&gt;Read the alternation.&lt;/b&gt; Every substantive step is followed by a guard: MaskPii &amp;#8594; GuardDeidentified, AssessEligibility &amp;#8594; GuardRulesExecuted. No model decides whether a guard passed. &lt;b&gt;CheckAdverseNotice&lt;/b&gt; is &lt;i&gt;Goldberg v. Kelly&lt;/i&gt; in code &amp;#8212; an adverse redetermination without advance notice terminates at AdverseNoticeHold. &lt;b&gt;AuditIntent&lt;/b&gt; writes the ledger row &lt;i&gt;before&lt;/i&gt; the side effect, which is what makes the trail a control rather than a log. &lt;b&gt;HumanSignoff&lt;/b&gt; is waitForTaskToken: single-use token, approver identity re-verified, approver &amp;#8800; requester.&lt;br&gt;Gate evidence: case &lt;b&gt;LIN-939EF8&lt;/b&gt; driven through all ten states." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C9D2DA;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2110" y="898" width="480" height="150" as="geometry"/></mxCell><mxCell id="n73" value="5 &amp;#183; GOVERNED TOOLS &amp;nbsp;&amp;nbsp;&lt;font style='font-size:12px;font-weight:normal;color:#5A6B7B'&gt;one Lambda per manifest tool target &amp;#183; exact-ARN least privilege &amp;#183; zero public egress&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="1086" width="2600" height="200" as="geometry"/></mxCell><mxCell id="n74" value="&lt;b&gt;intake_application&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6B7B'&gt;raw text enters here, and only here&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="1138" width="216" height="72" as="geometry"/></mxCell><mxCell id="n75" value="&lt;b&gt;mask_pii&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6B7B'&gt;issues the signed sanitized_ref&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="346" y="1138" width="216" height="72" as="geometry"/></mxCell><mxCell id="n76" value="&lt;b&gt;assess_eligibility&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6B7B'&gt;deterministic rules, no model&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="572" y="1138" width="216" height="72" as="geometry"/></mxCell><mxCell id="n77" value="&lt;b&gt;redetermine&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6B7B'&gt;changed-circumstances path&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="798" y="1138" width="216" height="72" as="geometry"/></mxCell><mxCell id="n78" value="&lt;b&gt;detect_overpayment&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6B7B'&gt;computes only, never recovers&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1024" y="1138" width="216" height="72" as="geometry"/></mxCell><mxCell id="n79" value="&lt;b&gt;draft_notice&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6B7B'&gt;the only tool that spends tokens&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1250" y="1138" width="216" height="72" as="geometry"/></mxCell><mxCell id="n80" value="&lt;b&gt;write_audit&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6B7B'&gt;append-only, hash-chained&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1476" y="1138" width="216" height="72" as="geometry"/></mxCell><mxCell id="n81" value="&lt;b&gt;request_signoff&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6B7B'&gt;raises the human gate&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1702" y="1138" width="216" height="72" as="geometry"/></mxCell><mxCell id="n82" value="&lt;b&gt;VPC &amp;#183; isolated subnets&lt;/b&gt;&lt;br&gt;no NAT &amp;#183; no IGW&lt;br&gt;AWS PrivateLink endpoints only&lt;br&gt;&lt;i&gt;measured, not asserted: 0 NAT, 0 IGW&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#8C4FFF;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1930" y="1132" width="300" height="84" as="geometry"/></mxCell><mxCell id="n83" value="&lt;b&gt;Hidden from the agent entirely:&lt;/b&gt; finalize_determination and refer_fraud. They are forbidden by Cedar &lt;i&gt;and&lt;/i&gt; absent from the advertised tool list. The only path to a commit is the human gate in band 4." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEF;strokeColor=#DD344C;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2250" y="1132" width="340" height="84" as="geometry"/></mxCell><mxCell id="c901" value="&lt;b&gt;verify_source&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#5A6B7B'&gt;governed outbound &amp;#183; holds no secret&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="1216" width="216" height="64" as="geometry"/></mxCell><mxCell id="c902" value="&lt;b&gt;New in this gate (CONN-1).&lt;/b&gt; The ninth tool is the first that leaves the account. It obtains an OAuth2 machine-to-machine token from the &lt;b&gt;AgentCore Identity token vault&lt;/b&gt; and holds no client secret itself; the system of record verifies the token&apos;s &lt;b&gt;RS256 signature against the issuer&apos;s live JWKS&lt;/b&gt; and answers an unauthenticated caller with 401. Cedar denied an outsider calling it &amp;#8212; naming a &lt;i&gt;specific&lt;/i&gt; policy, not refusing everyone alike. &lt;b&gt;The system of record is real and it is ours&lt;/b&gt;: proving the governed path reaches it is not proving a customer&apos;s system of record has been governed, which is why &lt;b&gt;connect_system_of_record stays stubbed&lt;/b&gt;. It took &lt;b&gt;six from-zero live runs&lt;/b&gt; to get right." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#ED7100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="346" y="1216" width="1572" height="64" as="geometry"/></mxCell><mxCell id="n84" value="6 &amp;#183; EVIDENCE &amp;amp; REGULATED DATA &amp;nbsp;&amp;nbsp;&lt;font style='font-size:12px;font-weight:normal;color:#5A6B7B'&gt;per-tenant physical isolation &amp;#183; customer-managed KMS &amp;#183; WORM custody&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="1310" width="2600" height="210" as="geometry"/></mxCell><mxCell id="n85" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="130" y="1360" width="78" height="78" as="geometry"/></mxCell><mxCell id="n86" value="&lt;b&gt;Audit ledger&lt;/b&gt;&lt;br&gt;append-only &amp;#183; hash chain&lt;br&gt;IAM Deny on update/delete" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="84" y="1440" width="170" height="56" as="geometry"/></mxCell><mxCell id="n87" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="188" y="1351" width="42" height="15" as="geometry"/></mxCell><mxCell id="n88" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_storage_service;" vertex="1" parent="1"><mxGeometry x="330" y="1360" width="78" height="78" as="geometry"/></mxCell><mxCell id="n89" value="&lt;b&gt;Sanitized artifacts&lt;/b&gt;&lt;br&gt;signed sanitized_ref&lt;br&gt;pass-by-reference store" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="284" y="1440" width="170" height="56" as="geometry"/></mxCell><mxCell id="n90" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="388" y="1351" width="42" height="15" as="geometry"/></mxCell><mxCell id="n91" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_storage_service;" vertex="1" parent="1"><mxGeometry x="530" y="1360" width="78" height="78" as="geometry"/></mxCell><mxCell id="n92" value="&lt;b&gt;WORM evidence vault&lt;/b&gt;&lt;br&gt;S3 Object Lock&lt;br&gt;retention profiles" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="484" y="1440" width="170" height="56" as="geometry"/></mxCell><mxCell id="n93" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="588" y="1351" width="42" height="15" as="geometry"/></mxCell><mxCell id="n94" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="730" y="1360" width="78" height="78" as="geometry"/></mxCell><mxCell id="n95" value="&lt;b&gt;AWS KMS&lt;/b&gt;&lt;br&gt;customer-managed key&lt;br&gt;tables, logs, SNS, env" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="1440" width="170" height="56" as="geometry"/></mxCell><mxCell id="n96" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="788" y="1351" width="42" height="15" as="geometry"/></mxCell><mxCell id="n97" value="&lt;b&gt;Four retention profiles, and the honest reading of each.&lt;/b&gt;&lt;br&gt;&amp;#8226; &lt;b&gt;sandbox-demo&lt;/b&gt; &amp;#8212; GOVERNANCE / 1 day. What every gate ran.&lt;br&gt;&amp;#8226; &lt;b&gt;pilot&lt;/b&gt; &amp;#8212; GOVERNANCE / 90 days.&lt;br&gt;&amp;#8226; &lt;b&gt;compliance-proof&lt;/b&gt; &amp;#8212; &lt;b&gt;COMPLIANCE / 1 day. Live-proven (EV-1):&lt;/b&gt; BypassGovernanceRetention is refused and the deployment's own teardown fails.&lt;br&gt;&amp;#8226; &lt;b&gt;production-reference&lt;/b&gt; &amp;#8212; COMPLIANCE / 2555 days. &lt;b&gt;Never deployed.&lt;/b&gt;&lt;br&gt;&lt;b&gt;Say it exactly this way:&lt;/b&gt; the immutability &lt;i&gt;mechanism&lt;/i&gt; is proven; the seven-year &lt;i&gt;duration&lt;/i&gt; is a parameter, not evidence." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#B26A00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="920" y="1356" width="830" height="146" as="geometry"/></mxCell><mxCell id="n98" value="&lt;b&gt;Per-tenant physical isolation.&lt;/b&gt; Each tenant gets its own DataStack &amp;#8212; its own tables and its own WORM bucket &amp;#8212; not a shared table with a tenant key. The gateway interceptor derives the tenant from the caller's own validated identity and the target routes to &lt;i&gt;that&lt;/i&gt; tenant's store, so a caller can only ever reach its own.&lt;br&gt;Gate evidence: two tenants (sp-a, sp-b), per-tenant audit routing 12/12, transparency 13/13 each, strict PII canary clean.&lt;br&gt;&lt;br&gt;&lt;b&gt;Policy provenance, newly proven live 2026-09-09:&lt;/b&gt; ledger rows carry &lt;b&gt;policy_version&lt;/b&gt; and &lt;b&gt;rule_version&lt;/b&gt; &amp;#8212; an auditor can ask which policy decided a case and get an answer from the record." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F7EC;strokeColor=#1D8102;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1790" y="1356" width="800" height="146" as="geometry"/></mxCell><mxCell id="n99" value="7 &amp;#183; CAPTURE &amp;amp; LINEAGE &amp;nbsp;&amp;nbsp;&lt;font style='font-size:12px;font-weight:normal;color:#5A6B7B'&gt;the account-wide net &amp;#8212; and precisely how wide it is not&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="1544" width="2600" height="195" as="geometry"/></mxCell><mxCell id="n100" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" vertex="1" parent="1"><mxGeometry x="130" y="1592" width="78" height="78" as="geometry"/></mxCell><mxCell id="n101" value="&lt;b&gt;CloudTrail&lt;/b&gt;&lt;br&gt;account trail, multi-region&lt;br&gt;log-file validation ON" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="84" y="1672" width="170" height="56" as="geometry"/></mxCell><mxCell id="n102" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="188" y="1583" width="42" height="15" as="geometry"/></mxCell><mxCell id="n103" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="1"><mxGeometry x="330" y="1592" width="78" height="78" as="geometry"/></mxCell><mxCell id="n104" value="&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;joinable capture for&lt;br&gt;the lineage proof" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="284" y="1672" width="170" height="56" as="geometry"/></mxCell><mxCell id="n105" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="388" y="1583" width="42" height="15" as="geometry"/></mxCell><mxCell id="n106" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_storage_service;" vertex="1" parent="1"><mxGeometry x="530" y="1592" width="78" height="78" as="geometry"/></mxCell><mxCell id="n107" value="&lt;b&gt;Capture bucket&lt;/b&gt;&lt;br&gt;S3 Object Lock&lt;br&gt;the capture is itself WORM" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="484" y="1672" width="170" height="56" as="geometry"/></mxCell><mxCell id="n108" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="588" y="1583" width="42" height="15" as="geometry"/></mxCell><mxCell id="n109" value="&lt;b&gt;What is captured:&lt;/b&gt; every &lt;b&gt;management&lt;/b&gt; API call in the account (InvokeModel, Converse and ConverseStream are management events), plus &lt;b&gt;advanced data-event selectors&lt;/b&gt; for every Bedrock data-plane resource type, the AgentCore Gateway and Runtime, Lambda invokes and S3 objects.&lt;br&gt;&lt;b&gt;The lineage proof reconciles both directions:&lt;/b&gt; a tool invoked but unaudited, or audited but not actually invoked, is an &lt;b&gt;orphan&lt;/b&gt; and fails.&lt;br&gt;Gate evidence: &lt;b&gt;orphans=0, invokes=11, aegis=11&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C9D2DA;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="720" y="1588" width="900" height="132" as="geometry"/></mxCell><mxCell id="n110" value="&lt;b&gt;What is NOT captured &amp;#8212; correct this if you hear it overstated (R4-7).&lt;/b&gt;&lt;br&gt;It is &lt;i&gt;not&lt;/i&gt; every DynamoDB/S3 data event account-wide. It does &lt;b&gt;not&lt;/b&gt; see SageMaker-hosted or self-hosted models, Amazon Q, external model APIs, or uninstrumented workloads (PERIM-7).&lt;br&gt;&quot;Every API call&quot; means &lt;b&gt;every call on the governed path&lt;/b&gt;; the account-wide net is &lt;b&gt;management events&lt;/b&gt;. Multi-account aggregation to a log-archive account is &lt;b&gt;open&lt;/b&gt; (PERIM-6)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEF;strokeColor=#DD344C;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1660" y="1588" width="930" height="132" as="geometry"/></mxCell><mxCell id="n111" value="8 &amp;#183; OPERATIONS &amp;amp; CONTAINMENT &amp;nbsp;&amp;nbsp;&lt;font style='font-size:12px;font-weight:normal;color:#5A6B7B'&gt;26 named alarms in 3 severity tiers &amp;#8212; read the correction note&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D72F3;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="1763" width="2600" height="205" as="geometry"/></mxCell><mxCell id="n112" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;" vertex="1" parent="1"><mxGeometry x="130" y="1811" width="78" height="78" as="geometry"/></mxCell><mxCell id="n113" value="&lt;b&gt;Operations dashboard&lt;/b&gt;&lt;br&gt;1 dashboard &amp;#183; 6 widgets&lt;br&gt;&lt;i&gt;per-tenant view still open&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="84" y="1891" width="170" height="56" as="geometry"/></mxCell><mxCell id="n114" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="188" y="1802" width="42" height="15" as="geometry"/></mxCell><mxCell id="n115" value="" style="rounded=1;arcSize=18;html=1;fillColor=#E7157B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="284" y="1811" width="170" height="12" as="geometry"/></mxCell><mxCell id="n116" value="&lt;b&gt;Alarms&lt;/b&gt;&lt;br&gt;&lt;b&gt;26, all named&lt;/b&gt;&lt;br&gt;3 severity tiers: P1/P2/P3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;dashed=0;fontSize=11;fontColor=#232F3E;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="284" y="1819" width="170" height="114" as="geometry"/></mxCell><mxCell id="n117" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="408" y="1802" width="42" height="15" as="geometry"/></mxCell><mxCell id="n118" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_notification_service;" vertex="1" parent="1"><mxGeometry x="530" y="1811" width="78" height="78" as="geometry"/></mxCell><mxCell id="n119" value="&lt;b&gt;SNS&lt;/b&gt;&lt;br&gt;4 topics: all-alarms +&lt;br&gt;one per severity tier" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="484" y="1891" width="170" height="56" as="geometry"/></mxCell><mxCell id="n120" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="588" y="1802" width="42" height="15" as="geometry"/></mxCell><mxCell id="n121" value="" style="rounded=1;arcSize=18;html=1;fillColor=#E7157B;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="684" y="1811" width="170" height="12" as="geometry"/></mxCell><mxCell id="n122" value="&lt;b&gt;AWS Budgets&lt;/b&gt;&lt;br&gt;USD ceiling &amp;#8594;&lt;br&gt;breach function" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;dashed=0;fontSize=11;fontColor=#232F3E;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="684" y="1819" width="170" height="114" as="geometry"/></mxCell><mxCell id="n123" value="LIVE" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#FFFFFF;fillColor=#1D8102;strokeColor=none;rounded=1;arcSize=40;" vertex="1" parent="1"><mxGeometry x="808" y="1802" width="42" height="15" as="geometry"/></mxCell><mxCell id="n124" value="&lt;b&gt;Kill switch&lt;/b&gt;&lt;br&gt;one SSM parameter&lt;br&gt;halts the governed path&lt;br&gt;IAM-attributed &amp;#183; WORM-audited&lt;br&gt;&lt;i&gt;13.9s to effect&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FDECEF;strokeColor=#DD344C;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="1807" width="250" height="100" as="geometry"/></mxCell><mxCell id="n125" value="&lt;b&gt;Per-tenant token + USD budget.&lt;/b&gt; Reserve-before / commit-after on every model call. Refuses &lt;b&gt;before&lt;/b&gt; the spend at runtime, gateway and drafter &amp;#8212; including mid-session. 60% and 85% alarms; the AWS Budgets ceiling engages the kill switch automatically, and the ledger records &quot;engaged by the budget breach function&quot;.&lt;br&gt;Gate evidence: kill switch rc=0 in 102.4s; budget rc=0 in 372.6s." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#C9D2DA;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1170" y="1807" width="700" height="132" as="geometry"/></mxCell><mxCell id="n126" value="&lt;b&gt;CORRECTION &amp;#8212; an earlier version of this diagram said &amp;quot;three alarms&amp;quot;.&lt;/b&gt;&lt;br&gt;That came from counting &lt;b&gt;cw.Alarm(&lt;/b&gt; call sites in the source; two of the three are inside loops. The template carried &lt;b&gt;twenty-two&lt;/b&gt;. Counting the generating code instead of the deployed artifact &amp;#8212; the same defect as register L60 and L67.&lt;br&gt;&lt;b&gt;Now 26, every one named&lt;/b&gt; (nine previously existed only as CloudFormation logical ids, so no runbook could reference them), in &lt;b&gt;three severity tiers&lt;/b&gt;, with latency alarmed and a stalled sign-off detected in 2h rather than 24h. Counts come from &lt;b&gt;tools/observability_census.py&lt;/b&gt;, which reads the template and fails CI on drift.&lt;br&gt;&lt;b&gt;Still open:&lt;/b&gt; per-tenant dashboards, a synthetic canary, proof that a tier has ever fired in a real incident, a real on-call rotation, and a DR exercise." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F7EC;strokeColor=#1D8102;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1890" y="1807" width="700" height="132" as="geometry"/></mxCell><mxCell id="n127" value="LEGEND &amp;#8212; every component: what it is, why it is there, what it stops &amp;nbsp;&amp;nbsp;&lt;font style='font-size:12px;font-weight:normal;color:#5A6B7B'&gt;status as of the 2026-09-10 gate (ben-fpg, 21/21) &amp;#183; nothing here is proven on real data&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#232F3E;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="1992" width="2600" height="1252" as="geometry"/></mxCell><mxCell id="n128" value="Component" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;strokeWidth=1;dashed=0;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2038" width="250" height="30" as="geometry"/></mxCell><mxCell id="n129" value="Layer" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;strokeWidth=1;dashed=0;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2038" width="130" height="30" as="geometry"/></mxCell><mxCell id="n130" value="Status" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;strokeWidth=1;dashed=0;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2038" width="74" height="30" as="geometry"/></mxCell><mxCell id="n131" value="What it is" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;strokeWidth=1;dashed=0;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2038" width="800" height="30" as="geometry"/></mxCell><mxCell id="n132" value="Why it is there &amp;#8212; what it stops" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;strokeWidth=1;dashed=0;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2038" width="1270" height="30" as="geometry"/></mxCell><mxCell id="n133" value="&lt;b&gt;Amazon Cognito&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2068" width="250" height="46" as="geometry"/></mxCell><mxCell id="n134" value="1 Identity" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2068" width="130" height="46" as="geometry"/></mxCell><mxCell id="n135" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2068" width="74" height="46" as="geometry"/></mxCell><mxCell id="n136" value="Issues the access token carrying cognito:groups, custom:tenant and custom:tools." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2068" width="800" height="46" as="geometry"/></mxCell><mxCell id="n137" value="Stops an unauthenticated or un-tenanted caller reaching any tool. Zero built-in users, so there is no default credential." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2068" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n138" value="&lt;b&gt;AWS WAF&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2114" width="250" height="46" as="geometry"/></mxCell><mxCell id="n139" value="1 Identity" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2114" width="130" height="46" as="geometry"/></mxCell><mxCell id="n140" value="&lt;b&gt;IAC&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#B26A00;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2114" width="74" height="46" as="geometry"/></mxCell><mxCell id="n141" value="Managed common rule set + per-IP rate limit on the Cognito front door." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2114" width="800" height="46" as="geometry"/></mxCell><mxCell id="n142" value="Blunts credential-stuffing and volumetric abuse at the edge. Built by CDK; the association has not been live re-proven." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2114" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n143" value="&lt;b&gt;Enterprise IdP&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2160" width="250" height="46" as="geometry"/></mxCell><mxCell id="n144" value="1 Identity" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2160" width="130" height="46" as="geometry"/></mxCell><mxCell id="n145" value="&lt;b&gt;OFF&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#6B7785;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2160" width="74" height="46" as="geometry"/></mxCell><mxCell id="n146" value="Customer's Okta / Entra ID / Ping over OIDC." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2160" width="800" height="46" as="geometry"/></mxCell><mxCell id="n147" value="Production identity. The round-trip has never been exercised &amp;#8212; a named pre-pilot item (R4-15)." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2160" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n148" value="&lt;b&gt;AgentCore Gateway&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2206" width="250" height="46" as="geometry"/></mxCell><mxCell id="n149" value="2 Authorization" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2206" width="130" height="46" as="geometry"/></mxCell><mxCell id="n150" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2206" width="74" height="46" as="geometry"/></mxCell><mxCell id="n151" value="MCP endpoint with CUSTOM_JWT; advertises the tool list per caller." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2206" width="800" height="46" as="geometry"/></mxCell><mxCell id="n152" value="The single admission point for tool use. An entitlement-less caller is advertised nothing." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2206" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n153" value="&lt;b&gt;Cedar Policy engine&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2252" width="250" height="46" as="geometry"/></mxCell><mxCell id="n154" value="2 Authorization" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2252" width="130" height="46" as="geometry"/></mxCell><mxCell id="n155" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2252" width="74" height="46" as="geometry"/></mxCell><mxCell id="n156" value="AWS GA engine in ENFORCE. 13 policies: 1 permit, 12 forbid, forbid-wins." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2252" width="800" height="46" as="geometry"/></mxCell><mxCell id="n157" value="The governance cannot be talked out of by the agent it governs &amp;#8212; it is evaluated by AWS before any tool runs." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2252" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n158" value="&lt;b&gt;REQUEST interceptor&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2298" width="250" height="46" as="geometry"/></mxCell><mxCell id="n159" value="2 Authorization" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2298" width="130" height="46" as="geometry"/></mxCell><mxCell id="n160" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2298" width="74" height="46" as="geometry"/></mxCell><mxCell id="n161" value="Sets tenant, budget_ok and within_service_window from authoritative sources." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2298" width="800" height="46" as="geometry"/></mxCell><mxCell id="n162" value="Stops a caller asserting its own budget, tenancy or time window. Caller-supplied values are overwritten, not trusted." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2298" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n163" value="&lt;b&gt;AgentCore Runtime&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2344" width="250" height="46" as="geometry"/></mxCell><mxCell id="n164" value="3 Agent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2344" width="130" height="46" as="geometry"/></mxCell><mxCell id="n165" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2344" width="74" height="46" as="geometry"/></mxCell><mxCell id="n166" value="Runs the agent on the CDK-declared execution role, MMDSv2 required." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2344" width="800" height="46" as="geometry"/></mxCell><mxCell id="n167" value="Stops the toolkit's auto-generated over-broad role being used, and closes the IMDSv1 credential-theft path." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2344" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n168" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2390" width="250" height="46" as="geometry"/></mxCell><mxCell id="n169" value="3 Agent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2390" width="130" height="46" as="geometry"/></mxCell><mxCell id="n170" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2390" width="74" height="46" as="geometry"/></mxCell><mxCell id="n171" value="Regional service reached over PrivateLink from isolated subnets." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2390" width="800" height="46" as="geometry"/></mxCell><mxCell id="n172" value="Keeps inference off the public internet. Not the same claim as &amp;quot;Bedrock runs in your VPC&amp;quot; &amp;#8212; see NOT-CLAIMS.md." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2390" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n173" value="&lt;b&gt;Bedrock Guardrail&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2436" width="250" height="46" as="geometry"/></mxCell><mxCell id="n174" value="3 Agent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2436" width="130" height="46" as="geometry"/></mxCell><mxCell id="n175" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2436" width="74" height="46" as="geometry"/></mxCell><mxCell id="n176" value="PII + content policy; the exact ARN is an IAM StringEquals condition with an explicit Deny." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2436" width="800" height="46" as="geometry"/></mxCell><mxCell id="n177" value="Stops a model call that names no guardrail, or the wrong one, from succeeding at all." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2436" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n178" value="&lt;b&gt;Step Functions&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2482" width="250" height="46" as="geometry"/></mxCell><mxCell id="n179" value="4 Orchestration" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2482" width="130" height="46" as="geometry"/></mxCell><mxCell id="n180" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2482" width="74" height="46" as="geometry"/></mxCell><mxCell id="n181" value="STANDARD state machine, ten states, a guard after every substantive step." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2482" width="800" height="46" as="geometry"/></mxCell><mxCell id="n182" value="Stops the pipeline advancing on unverified state. The model cannot reorder or skip a control." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2482" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n183" value="&lt;b&gt;Human sign-off gate&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="2528" width="250" height="46" as="geometry"/></mxCell><mxCell id="n184" value="4 Orchestration" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=10;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="324" y="2528" width="130" height="46" as="geometry"/></mxCell><mxCell id="n185" value="&lt;b&gt;LIVE&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#1D8102;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="458" y="2528" width="74" height="46" as="geometry"/></mxCell><mxCell id="n186" value="waitForTaskToken; single-use token; approver identity re-verified." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="536" y="2528" width="800" height="46" as="geometry"/></mxCell><mxCell id="n187" value="Stops any consequential action completing without a second, different, qualified human." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D2DA;strokeWidth=1;dashed=0;fontSize=11;fontStyle=0;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="2528" width="1270" height="46" as="geometry"/></mxCell><mxCell id="n188" value="&lt;b&gt;Governed tool Lambdas&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F2F5F7;strokeColor=#C9D2DA;strokeWidth=1;dashed=0